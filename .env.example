# Every setting backend/adforge/settings.py reads from the environment. Copy to .env and fill
# in the keys; docker compose reads .env. The lines commented out have a working default:
# uncomment one only to change it, since a blank value replaces the default. In cloud sessions
# these are environment variables, not a .env file.

# Django
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=
# DJANGO_ALLOWED_HOSTS=
# MEDIA_ROOT=
# CELERY_BROKER_URL=

# OpenAI: the producer, the planner, the checkers, the pictures
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# Azure's copy of the same OpenAI models. When both are set, they're used instead of the two above.
AZURE_OPENAI_KEY=
AZURE_OPENAI_BASE_URL=

# Firecrawl: reads product pages in a real browser
FIRECRAWL_API_KEY=
# FIRECRAWL_URL=

# Inworld: the voice
INWORLD_API_KEY=
# INWORLD_BASE_URL=

# ElevenLabs: hears each line, word by word
ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=

# fal: the music, and the storage B-roll pictures are sent to Creatify from
FAL_KEY=
# FAL_BASE_URL=
# FAL_QUEUE_URL=
# FAL_STORAGE_URL=

# HeyGen: talking clips
HEYGEN_API_KEY=
# HEYGEN_BASE_URL=

# Creatify: B-roll clips, made by Boreal-H3
CREATIFY_API_ID=
CREATIFY_API_KEY=
# CREATIFY_BASE_URL=
# auto (the default: Creatify rewrites the prompt) or none
# CREATIFY_PROMPT_ENHANCEMENT=

# Langfuse: traces of every agent turn and model call
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=

# ffmpeg, if not on the PATH
# FFMPEG=
# FFPROBE=

# Quality checks on pictures and clips already made (1 = on, 0 = off; off by default)
# QUALITY_CHECKS=0
